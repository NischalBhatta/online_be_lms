MONGO_URL=

ACCESSJWT_SECRET=
REFRESHJWT_SECRET=

# Frontend URL, used to build account activation links
ROOT_URL=

# "production" sends email via Resend; anything else uses SMTP (e.g. Ethereal) below
NODE_ENV=

# Dev email (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_EMAIL=
SMTP_PASS=

# Production email (Resend). EMAIL_FROM must use a domain verified at https://resend.com/domains
# e.g. EMAIL_FROM="Local Library <noreply@yourdomain.com>"  (a @gmail.com address will be rejected)
# Leave EMAIL_FROM empty to use Resend's shared sender onboarding@resend.dev (free tier, no domain:
# it only delivers to your own Resend account email)
RESEND_API_KEY=
EMAIL_FROM=
